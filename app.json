{
  "expo": {
    "name": "Athonis Entregas",
    "slug": "athonis-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "athonis",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.athonis.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "O Athonis usa sua localização para registrar onde cada entrega foi feita.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "O Athonis registra o trajeto enquanto há uma rota em andamento, mesmo com a tela apagada, para comparar a rota planejada com a executada."
      }
    },
    "android": {
      "package": "com.athonis.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#2F5DE3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F5DE3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Athonis usa sua localização para registrar onde cada entrega foi feita.",
          "locationAlwaysAndWhenInUsePermission": "O Athonis registra o trajeto enquanto há uma rota em andamento, mesmo com a tela apagada, para comparar a rota planejada com a executada.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
